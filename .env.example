# AI Government Scheme Fact Checker — environment variables
# Copy this file to .env and fill in real values. NEVER commit .env to git.

# Django
SECRET_KEY=your-very-long-random-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///db.sqlite3

# Gemini AI — get key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# Celery / Redis (optional for async tasks)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Research cache TTL in seconds (default 1 hour)
RESEARCH_CACHE_TTL_SECONDS=3600
